[Unit]
Description=Abyssal RAM-only chat relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mirage
Group=mirage
WorkingDirectory=/opt/mirage/mirage-server
ExecStart=/opt/mirage/mirage-server/target/release/mirage-server
Restart=always
RestartSec=3
Environment=ABYSSAL_BIND_ADDR=0.0.0.0:4020
Environment=ABYSSAL_NODE_ID=oracle-ampere-1
Environment=ABYSSAL_CODE_COUNT=8
Environment=ABYSSAL_ADMIN_CODE_COUNT=1
Environment=ABYSSAL_CODE_MIN_LEN=12
Environment=ABYSSAL_CODE_MAX_LEN=20
Environment=RUST_LOG=mirage_server=info,tower_http=info
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
