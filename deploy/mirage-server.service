[Unit]
Description=Abyssal RAM-only chat relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mirage
Group=mirage
WorkingDirectory=/opt/abyssal
ExecStart=/opt/abyssal/target/release/mirage-server
Restart=always
RestartSec=3
Environment=ABYSSAL_BIND_ADDR=0.0.0.0:4020
Environment=ABYSSAL_NODE_ID=abyssal-node-1
Environment=ABYSSAL_CODE_COUNT=8
Environment=ABYSSAL_CODE_MIN_LEN=12
Environment=ABYSSAL_CODE_MAX_LEN=20
Environment=ABYSSAL_MAX_ROOMS_PER_USER=5
Environment=ABYSSAL_SESSION_INACTIVITY_MINUTES=15
Environment=ABYSSAL_WEB_ROOT=/opt/abyssal/apps/web/dist
Environment=RUST_LOG=mirage_server=info,tower_http=info
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
