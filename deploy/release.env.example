# Copy to deploy/release.env. This is a data-only file, never a shell script.
# Keep it and the keystore private. One literal assignment per line; blank
# lines and comments are allowed. Values may contain spaces and '=' but not
# control characters. The parser rejects unknown or duplicate assignments.
ABYSSAL_KEYSTORE_PATH=/absolute/path/to/abyssal-release.jks
ABYSSAL_KEYSTORE_PASSWORD=replace-me
ABYSSAL_KEY_ALIAS=abyssal-release
ABYSSAL_KEY_PASSWORD=replace-me
