ABYSSAL_BIND_ADDR=0.0.0.0:4020
# Stable infrastructure identity. Generate once with deploy/generate-node-key.sh.
ABYSSAL_NODE_SIGNING_KEY_FILE=/run/secrets/abyssal-node-signing-key
# Public address embedded in signed invites. Set this before startup.
# Remote deployments require HTTPS; only explicit loopback development may use HTTP.
ABYSSAL_PUBLIC_URL=
ABYSSAL_INVITE_COUNT=8
# 0 means no wall-clock expiry; one-time account creation consumption still applies.
ABYSSAL_INVITE_EXPIRY_HOURS=0
ABYSSAL_INVITE_PRINT_DELAY_MS=4000
ABYSSAL_ATTACHMENT_RAM_LIMIT_MB=512
ABYSSAL_ATTACHMENT_ACCOUNT_LIMIT_MB=320
# Maximum number of encrypted attachment records retained in RAM globally and per account.
# Values are clamped to 1-65536; the per-account limit is capped by the global limit.
ABYSSAL_ATTACHMENT_RECORD_LIMIT=16384
ABYSSAL_ATTACHMENT_ACCOUNT_RECORD_LIMIT=4096
# Hard relay-side maximum lifetime for every encrypted attachment, including ttl=0.
# Values are clamped to 1-720 hours. The default is 168 hours (7 days).
ABYSSAL_ATTACHMENT_MAX_LIFETIME_HOURS=168
ABYSSAL_ATTACHMENT_DOWNLOAD_CONCURRENCY=2
ABYSSAL_ATTACHMENT_UPLOAD_CONCURRENCY=2
ABYSSAL_MAX_ROOMS_PER_USER=5
# Pending encrypted frames expire after this many hours. Values are clamped to 1-168; 0 is not unbounded.
ABYSSAL_PENDING_MESSAGE_TTL_HOURS=24
# Authenticated sessions expire after this many minutes without real client activity.
ABYSSAL_SESSION_INACTIVITY_MINUTES=15
# Disabled when 0. When positive, relay wipes RAM state after this many idle hours.
ABYSSAL_INACTIVITY_LIMIT_HOURS=0
# Build-attested platform delivery policy. Only exact true/false values are accepted.
# Same-platform delivery is always allowed.
ABYSSAL_ALLOW_ANDROID_TO_WEB=false
ABYSSAL_ALLOW_WEB_TO_ANDROID=true
# Only needed when web UI is hosted on another origin, such as local Vite development.
# Same-origin production deployment should leave this empty.
ABYSSAL_WEB_ORIGINS=
RUST_LOG=mirage_server=info,tower_http=info
